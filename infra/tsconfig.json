{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Use Node's modern package.json-aware resolver instead of TypeScript's
    // legacy `node10` resolver.
    "module": "Node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    // tsc only type-checks; tsx (esbuild) runs the CDK app file by file, so
    // each file must be transpilable in isolation.
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"]
}
