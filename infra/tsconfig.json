{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Use Node's modern package.json-aware resolver instead of TypeScript's
    // legacy `node10` resolver.
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "resolveJsonModule": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"]
}
