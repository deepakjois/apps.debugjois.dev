#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=.agents/nix-env.sh
source "$repo_root/.agents/nix-env.sh"

stamp="$APPS_DEBUGJOIS_DEV_TOOLS.stamp"
fingerprint="$(cat "$repo_root/flake.nix" "$repo_root/flake.lock" | sha256sum | cut -d' ' -f1)"

if [[ "${1-}" == "--if-changed" && -d "$APPS_DEBUGJOIS_DEV_TOOLS/bin" ]] &&
  [[ "$(cat "$stamp" 2>/dev/null)" == "$fingerprint" ]]; then
  exit 0
fi

mkdir -p "$(dirname "$APPS_DEBUGJOIS_DEV_TOOLS")"
nix --extra-experimental-features 'nix-command flakes' build \
  --out-link "$APPS_DEBUGJOIS_DEV_TOOLS" "$repo_root#default"
printf '%s\n' "$fingerprint" >"$stamp"
