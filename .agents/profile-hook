#!/usr/bin/env bash
set -euo pipefail

# Amp appends its own block to ~/.bash_profile on every orb activation; that block sources ~/.env,
# whose literal PATH would otherwise drop the tool profile, so the hook is kept as the last block.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
profile="$HOME/.bash_profile"
marker="# apps.debugjois.dev Nix tools"

hook="$marker
if [[ ( \"\$PWD\" == \"$repo_root\" || \"\$PWD\" == \"$repo_root/\"* ) && -r \"$repo_root/.agents/nix-env.sh\" ]]; then
  source \"$repo_root/.agents/nix-env.sh\"
fi"

touch "$profile"

rest="$(awk -v marker="$marker" '
  $0 == marker { skip = 1; blanks = 0; next }
  skip { if ($0 == "fi") skip = 0; next }
  $0 == "" { blanks++; next }
  { while (blanks > 0 && printed) { print ""; blanks-- } blanks = 0; print; printed = 1 }
' "$profile")"

desired="${rest:+$rest$'\n\n'}$hook"
if [[ "$(cat "$profile")" != "$desired" ]]; then
  printf '%s\n' "$desired" >"$profile"
fi
