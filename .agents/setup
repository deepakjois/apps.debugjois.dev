#!/usr/bin/env bash
set -euo pipefail

# Pinned toolchains shared by the frontend, backend, and infrastructure projects.
readonly NODE_VERSION="26.5.1"
readonly NPM_VERSION="12.0.2"
readonly GO_VERSION="1.26.8"
readonly GOLANGCI_LINT_VERSION="2.13.2"

step() {
  printf '\n==> %s\n' "$1"
}

install_node() {
  if command -v node >/dev/null && [[ "$(node --version)" == "v${NODE_VERSION}" ]] &&
    command -v npm >/dev/null && [[ "$(npm --version)" == "${NPM_VERSION}" ]]; then
    return
  fi

  local archive
  archive="$(mktemp)"
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" -o "$archive"
  sudo rm -rf "/usr/local/lib/nodejs/node-v${NODE_VERSION}-linux-x64"
  sudo mkdir -p /usr/local/lib/nodejs
  sudo tar -xzf "$archive" -C /usr/local/lib/nodejs
  rm -f "$archive"

  for executable in node npm npx corepack; do
    sudo ln -sfn "/usr/local/lib/nodejs/node-v${NODE_VERSION}-linux-x64/bin/${executable}" "/usr/local/bin/${executable}"
  done

  sudo "/usr/local/lib/nodejs/node-v${NODE_VERSION}-linux-x64/bin/npm" install \
    --global "npm@${NPM_VERSION}" --no-audit --no-fund
}

install_go() {
  if command -v go >/dev/null && go version | grep -Fq "go${GO_VERSION}"; then
    return
  fi

  local archive
  archive="$(mktemp)"
  curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o "$archive"
  sudo rm -rf /usr/local/go
  sudo tar -xzf "$archive" -C /usr/local
  rm -f "$archive"
  sudo ln -sfn /usr/local/go/bin/go /usr/local/bin/go
  sudo ln -sfn /usr/local/go/bin/gofmt /usr/local/bin/gofmt
}

step "Installing system tools"
# Install only missing commands so warm orb setup avoids apt entirely.
system_packages=()
command -v aws >/dev/null || system_packages+=(awscli)
command -v zip >/dev/null || system_packages+=(zip)
if ((${#system_packages[@]} > 0)); then
  sudo apt-get update
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${system_packages[@]}"
fi

step "Installing Node.js ${NODE_VERSION} and npm ${NPM_VERSION}"
install_node

step "Installing Go ${GO_VERSION}"
install_go

step "Installing golangci-lint ${GOLANGCI_LINT_VERSION}"
mkdir -p "$HOME/.local/bin"
if ! command -v golangci-lint >/dev/null || [[ "$(golangci-lint version 2>/dev/null)" != *"version ${GOLANGCI_LINT_VERSION}"* ]]; then
  GOBIN="$HOME/.local/bin" go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v${GOLANGCI_LINT_VERSION}"
fi

# Each lockfile owns an independent dependency tree.
for project in app infra; do
  step "Installing ${project} dependencies"
  npm --prefix "$project" ci --no-audit --no-fund
done

step "Downloading backend Go modules"
(
  cd backend
  go mod download
)

step "Creating optional local environment files"
[[ -f backend/.env ]] || cp -- backend/.env.example backend/.env

printf '\nOrb setup complete.\n'
