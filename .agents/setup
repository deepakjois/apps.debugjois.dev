#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf '\n==> %s\n' "$1"
}

timed() {
  local name="$1" start
  shift
  step "$name"
  start=$SECONDS
  "$@"
  printf '    (%ss)\n' "$((SECONDS - start))"
}

install_nix() {
  if command -v nix >/dev/null || [[ -x "$HOME/.nix-profile/bin/nix" ]]; then
    return
  fi
  # Single-user install; the installer needs /nix to exist and be owned by us.
  sudo install -d -m 0755 -o "$(id -u)" -g "$(id -g)" /nix
  curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon --yes
}

install_npm_dependencies() {
  local project
  for project in app infra; do
    npm --prefix "$repo_root/$project" ci --no-audit --no-fund
  done
}

download_go_modules() {
  (cd "$repo_root/backend" && go mod download)
}

timed "Installing Nix" install_nix
timed "Building Nix tool profile" "$repo_root/.agents/nix-tools"
timed "Persisting login-shell hook" "$repo_root/.agents/profile-hook"

# shellcheck source=.agents/nix-env.sh
source "$repo_root/.agents/nix-env.sh"
printf '\nUsing %s, node %s, npm %s\n' "$(go version)" "$(node --version)" "$(npm --version)"

timed "Installing Go helper tools" "$repo_root/scripts/install-go-tools.sh"
timed "Installing npm dependencies" install_npm_dependencies
timed "Downloading Go modules" download_go_modules

printf '\nOrb setup complete.\n'
